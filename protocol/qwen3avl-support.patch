diff --git a/conversion/qwen3avl.py b/conversion/qwen3avl.py
new file mode 100644
index 0000000..b1ff6be
--- /dev/null
+++ b/conversion/qwen3avl.py
@@ -0,0 +1,99 @@
+from __future__ import annotations
+
+import os
+
+from typing import Callable, Iterable
+
+from torch import Tensor
+
+from .base import MmprojModel, ModelBase, gguf, logger
+from .qwen3vl import Qwen3VLTextModel, Qwen3VLVisionModel
+
+
+# Qwen3-AVL (ISSAI Qolda-AVL): Qwen3-VL extended with an audio branch built on a
+# fine-tuned Whisper encoder. Audio features are injected into the LLM both at the
+# input layer (main projection) and via DeepStack (features tapped from intermediate
+# Whisper encoder layers, injected into the first N decoder layers) - mirroring the
+# visual DeepStack mechanism of Qwen3-VL.
+# Reference: https://huggingface.co/issai/Qolda-AVL-5B
+
+
+@ModelBase.register("Qwen3AVLForConditionalGeneration")
+class Qwen3AVLTextModel(Qwen3VLTextModel):
+    # The LLM backbone is identical to Qwen3-VL. Audio tensors
+    # (model.audio_encoder.*, model.audio_projection.*, model.audio_deepstack_merger_list.*)
+    # are skipped by the base text-model filter and are handled by Qwen3AVLMmprojModel.
+    model_arch = gguf.MODEL_ARCH.QWEN3VL
+
+
+@ModelBase.register("Qwen3AVLForConditionalGeneration")
+class Qwen3AVLMmprojModel(Qwen3VLVisionModel):
+    has_vision_encoder = True
+    # set QWEN3AVL_MMPROJ_SKIP_AUDIO=1 to produce a vision-only mmproj that works with
+    # the QWEN3VL projector alone (no audio support required in the runtime)
+    has_audio_encoder = os.environ.get("QWEN3AVL_MMPROJ_SKIP_AUDIO", "") != "1"
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        if self.hparams_audio is not None:
+            # whisper config uses different key names
+            self.hparams_audio["hidden_size"] = self.hparams_audio["d_model"]
+            self.hparams_audio["intermediate_size"] = self.hparams_audio["encoder_ffn_dim"]
+            self.hparams_audio["num_attention_heads"] = self.hparams_audio["encoder_attention_heads"]
+        self.deepstack_audio_indexes = self.global_config.get("deepstack_audio_indexes", [])
+        if self.has_audio_encoder and not self.deepstack_audio_indexes:
+            logger.warning("qwen3avl: no deepstack_audio_indexes found in config")
+
+    def get_audio_config(self) -> dict | None:
+        return self.global_config.get("audio_config")
+
+    def set_gguf_parameters(self):
+        Qwen3VLVisionModel.set_gguf_parameters(self)
+        if self.has_audio_encoder:
+            # mixed modalities: vision + audio projector types are stored separately
+            self.gguf_writer.add_clip_vision_projector_type(gguf.VisionProjectorType.QWEN3VL)
+            self.gguf_writer.add_clip_audio_projector_type(gguf.VisionProjectorType.QWEN3AVL)
+            assert self.hparams_audio is not None
+            self.gguf_writer.add_audio_num_mel_bins(self.hparams_audio["num_mel_bins"])
+            self.gguf_writer.add_audio_attention_layernorm_eps(self.hparams_audio.get("layer_norm_eps", 1e-5))
+
+    @classmethod
+    def filter_tensors(cls, item: tuple[str, Callable[[], Tensor]]) -> tuple[str, Callable[[], Tensor]] | None:
+        name, gen = item
+
+        if name.startswith(("model.audio_encoder.", "model.audio_projection.", "model.audio_deepstack_merger_list.")):
+            if not cls.has_audio_encoder:
+                return None
+            # whisper encoder tensors ride the existing ultravox-style mappings
+            name = name.replace("model.audio_encoder.", "audio_tower.", 1)
+            name = name.replace("model.", "", 1)
+            return MmprojModel.filter_tensors((name, gen))
+
+        return Qwen3VLVisionModel.filter_tensors(item)
+
+    def modify_tensors(self, data_torch: Tensor, name: str, bid: int | None) -> Iterable[tuple[str, Tensor]]:
+        if name.startswith("audio_tower."):
+            if name.endswith(("conv1.bias", "conv2.bias")):
+                # transpose conv1 and conv2 bias for ggml conv1d
+                data_torch = data_torch.unsqueeze(-1)
+            yield from MmprojModel.modify_tensors(self, data_torch, name, bid)
+            return
+
+        if name.startswith("audio_projection.proj."):
+            # nn.Sequential(LayerNorm, Linear, GELU, Linear) -> ln + 2-layer MLP
+            _, _, idx, suffix = name.split(".")
+            mapped = {"0": "mm.a.norm_pre", "1": "mm.a.mlp.1", "3": "mm.a.mlp.2"}[idx]
+            yield (f"{mapped}.{suffix}", data_torch)
+            return
+
+        if name.startswith("audio_deepstack_merger_list."):
+            # merger N taps the output of whisper encoder layer deepstack_audio_indexes[N];
+            # store under the absolute encoder layer index (same scheme as visual deepstack)
+            _, merger_idx, rest = name.split(".", 2)
+            layer_idx = self.deepstack_audio_indexes[int(merger_idx)]
+            part, suffix = rest.split(".", 1)
+            mapped = {"norm": "norm", "linear_fc1": "fc1", "linear_fc2": "fc2"}[part]
+            yield (f"a.deepstack.{layer_idx}.{mapped}.{suffix}", data_torch)
+            return
+
+        yield from Qwen3VLVisionModel.modify_tensors(self, data_torch, name, bid)
